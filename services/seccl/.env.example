# --- Seccl API ---------------------------------------------------------------
SECCL_API_URL=https://pfolio-api-staging.seccl.tech
SECCL_FIRM_ID=SELCT
# private_key_jwt (production M2M) | client_secret (staging) | legacy (deprecated)
SECCL_AUTH_TYPE=private_key_jwt
SECCL_AUTH0_DOMAIN=https://seccl-staging-selct.uk.auth0.com/
# OAuth audience; leave blank to default to SECCL_API_URL
SECCL_AUDIENCE=
SECCL_CLIENT_ID=your-auth0-client-id
# private_key_jwt: key id + signing key registered with Seccl.
# Prefer the base64 form (`base64 -w0 seccl.pem`); the path is a fallback for
# file-mounted secrets and is ignored when the b64 value is set.
SECCL_KID=your-key-id
SECCL_PRIVATE_KEY_B64=
SECCL_PRIVATE_KEY_PATH=
# client_secret mode only
SECCL_CLIENT_SECRET=
# legacy mode only
SECCL_USER_ID=
SECCL_PASSWORD=

# --- Webhooks ------------------------------------------------------------------
# HMAC secret shared with Seccl (webhook-signature header)
SECCL_WEBHOOK_SECRET=generate-a-long-random-string
# Public base URL of the gateway, used by `python -m seccl_sync.webhooks_setup`
SECCL_WEBHOOK_URL=https://seccl-gateway.example.com

# --- Gateway -> interlace --------------------------------------------------------
GATEWAY_INTERLACE_URL=http://127.0.0.1:8100
# `interlace apikey create gateway --scope write` once keys are wanted; blank = open local dev
GATEWAY_INTERLACE_API_KEY=

# --- Warehouse (DuckLake: catalogue in the datalakes Postgres DB, parquet in the
# core bucket's datalake zone — docs/datalake.md). Local stack values shown.

# --- Warehouse identity (separates staging from production) ---------------------
SECCL_STATE_PATH=.interlace/state.db
SECCL_STREAM_PATH=.interlace/streams.db
# Cap documents fetched per raw.files run (0 = no cap; first pull of a big firm
# is thousands of PDFs).
SECCL_FILES_MAX_PER_RUN=0

# ── Shared object store + warehouse: set these ONCE in the ROOT `.env`, not here ───────────────
# Every provider service writes parquet into the same core bucket and catalogues it in the same
# `datalakes` Postgres, so these are canonical names the API and the compose stack already use:
#
#   DATALAKE_WRITER_DSN   libpq DSN for lake_writer, e.g.
#                         "dbname=datalakes host=localhost port=5432 user=lake_writer password=lake_writer"
#   S3_CORE_BUCKET        platforms
#   S3_ENDPOINT_HOST      localhost:9000   (host[:port], no scheme — the DuckDB secret's form)
#   S3_ACCESS_KEY_ID      rustfsadmin
#   S3_SECRET_ACCESS_KEY  rustfsadmin
#
# The moon tasks read `/.env` then this file, so a value here still overrides the shared one when a
# provider genuinely needs its own store. It previously had to: each service asked for its own
# `SECCL_WAREHOUSE_DSN` / `SECCL_S3_*`, so one value lived in three files and a port change meant
# three edits. Worth removing because of how the mistake fails, not because it is untidy: a wrong
# endpoint does not raise — the parquet lands where the reader never looks, and it presents as
# "the catalogue is empty".
