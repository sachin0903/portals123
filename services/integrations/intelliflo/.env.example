# Copy to .env (gitignored). This service reads /.env first (the root shared values below), then
# this file — a value here overrides the shared one.

# ── Postgres (the `portals` database — integrations.*, platform.accounts/links). This service's
# own names; not shared with other services since nothing else needs the `integrations` schema. ──
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=portals
PG_USER=migrator
PG_PASSWORD=migrator
PG_SET_ROLE=service_role

# ── The shared SEI DuckLake (docs/datalake.md) — read-only, as lake_reader. Same canonical names
# apps/api and the other provider syncs already use (root .env.example); normally left unset here
# and picked up from there. Local dev value, same as apps/api/.env.example:
#   DATALAKE_CATALOG_DSN=dbname=datalakes host=localhost port=5432 user=lake_reader password=lake_reader
#DATALAKE_CATALOG_DSN=
#S3_CORE_BUCKET=platforms
#S3_ENDPOINT_HOST=localhost:9000
#S3_ACCESS_KEY_ID=rustfsadmin
#S3_SECRET_ACCESS_KEY=rustfsadmin
#S3_USE_SSL=false

# ── Intelliflo Office API ──────────────────────────────────────────────────────────────────────
INTELLIFLO_CLIENT_ID=
INTELLIFLO_CLIENT_SECRET=
INTELLIFLO_TENANT_ID=
INTELLIFLO_API_KEY=
INTELLIFLO_APP_ID=
# Provider a NEW tenant row is created under by the tenant sync (on insert, and where a row's value is blank).
#INTELLIFLO_DEFAULT_PROVIDER_ID=5261
#INTELLIFLO_DEFAULT_PROVIDER_NAME=Graphene Platforms Ltd
#INTELLIFLO_TOKEN_URL=https://identity.gb.intelliflo.net/core/connect/token
#INTELLIFLO_API_BASE_URL=https://api.gb.intelliflo.net

# Per-feature cron overrides (Europe/London); unset ones fall back to INTELLIFLO_CRON.
#INTELLIFLO_CRON=30 9 * * 1-5
#INTELLIFLO_VALUATIONS_CRON=
#INTELLIFLO_TRANSACTIONS_CRON=
#INTELLIFLO_INCOME_STATEMENTS_CRON=
#INTELLIFLO_INCOME_STATEMENT_ITEMS_CRON=
#INTELLIFLO_TENANT_SYNC_CRON=0 6 * * *

# Webhook receiver (WebSub subscription verification + signature check)
INTELLIFLO_WEBHOOK_CALLBACK_URL=https://dev-api.grapheneplatforms.com/intelliflo/webhook
INTELLIFLO_WEBHOOK_SECRET=
#WEBHOOK_HOST=0.0.0.0
#WEBHOOK_PORT=4000

# ── Notifications (optional) ───────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
RESEND_EMAIL_API_KEY=
#SMTP_SENDER_EMAIL=no-reply@platform.grapheneplatforms.com
INTEGRATION_NOTIFY_EMAIL_TO=

# ── Manual-run filters (optional, for `intelliflo-engine-run` / local backfills) ───────────────
#RUN_PROVIDER=intelliflo
#RUN_FEATURE=
#DATA_DATE=
#LOG_LEVEL=INFO  # DEBUG also logs each query's SQL
