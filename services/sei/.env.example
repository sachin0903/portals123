# --- SEI SFTP ------------------------------------------------------------------
# SEI delivers the nightly report set over SFTP. One shared host across
# environments; the credential is per environment (SEI provisions SFTP only for
# some — i31 uses the integration account).
#
# NOTE: SEI restricts SFTP by SOURCE IP. Off-allowlist, auth fails with
# "transport shut down or saw EOF" even with correct credentials — run the pull
# from a host whose egress IP is allowlisted: the Coolify host, or a machine on the
# company VPN, which shares that egress.
SEI_SFTP_HOST=gws.ftp.seic.com
SEI_SFTP_PORT=22
SEI_SFTP_USERNAME=
SEI_SFTP_PASSWORD=
# Remote directory holding the drops. Blank = the SFTP login home directory.
SEI_SFTP_REMOTE_DIR=
# Which SEI environment these credentials belong to. Recorded, not interpolated into
# object keys: the bucket is per environment, so an i31 drop and a p04 drop are already
# in different buckets.
#
# ONLY i31 (test) AND p04 (production) ARE IN USE. i03/i04/i10 were earlier test
# environments and are not configured anywhere — their static-reference workbooks
# (`~/dev/sei/Graphene- Blackfinch SEI Professional Services/i0*_Static_Reference_Data.xlsx`)
# survive as EVIDENCE about the shape of SEI's reference data and are not a source: the
# nightly Reference report carries 183 code sets and supersedes them (docs/api-integrations.md
# §5). Do not point a deployment at i04.
SEI_ENV=i31
# A directory of drop files to read INSTEAD of the SFTP drop, so `raw.files` can be
# exercised off the SEI allowlist (the CLI's --local-dir, for a model that takes no
# arguments). Blank = the live SFTP drop.
SEI_LOCAL_DROP_DIR=
# There is deliberately no firm filter here. The drop is whole-group (one delivery
# group, all firms, with FIRM_ID on each row), the raw layer keeps it whole, and the
# per-tenant narrowing happens at fan-out from the tenant's provider config —
# firm_id + optional subfirm/DSR (docs/sei.md §3).

# --- SWP REST API (second source; docs/sei.md §1a) -----------------------------
# The drop is a DAILY DELTA, so a stretch of missed drops is a permanent hole. This API
# refills it — per account, 30 days at a time. Blank base URL disables it entirely and the
# SFTP pipeline runs unchanged.
#   i10/i31 (test): https://test.mtls.api.seic.com/api/v1/swp
#   p04  (prod)   : https://mtls.api.seic.com/api/v1/swp
# The same credentials list and download client documents (and the firm pack, which is a
# group on that list, not a second service). The paths are all-lowercase; a camelCase
# service name 404s "Unable to identify proxy". See docs/sei.md.
SEI_API_BASE_URL=
SEI_OAUTH_USERNAME=
SEI_OAUTH_PASSWORD=
SEI_APPKEY=
SEI_APPSECRET=
# mTLS client identity issued by SEI (a PKCS#12), base64-encoded so a deployment sets one
# secret instead of mounting a file: `base64 -w0 sei.pfx`. NEVER commit the decoded pfx.
#
# THE ONLY FORM — a `SEI_PFX_PATH` fallback existed until Aug 2026 and is gone. A deployment
# sets one secret rather than mounting a file, and two forms meant two precedence rules that had
# already drifted from `pkgs/sei` (its `configured` check asked for the path while its
# `ssl_context` preferred the base64, so a container supplying only base64 was refused).
#
# REQUIRED for every API call, including the enrolment-template read `ref.enrollment_templates`
# depends on. Unset, `SeiApi` refuses at construction naming this variable.
SEI_PFX_BASE64=
SEI_PFX_PASSWORD=
# ``GET /employeeservice/firmemployeeusers`` requires serviceId. The OpenAPI example is 152;
# on i31 that returns 0 rows. Service 1 is a superset of every other populated id in 1–250
# (not a DSR tag — those 400 as invalid). processingOrgId is resolved from each firm's
# defaults (it is NOT the firm id: 3102's processing org is 3100).
SEI_SERVICE_ID=1
# Days to re-read behind the cursor on an incremental run. SEI cannot filter by
# last-modified, so this overlap is the only way an amendment to an older transaction is
# ever seen; merge_by_key makes the repeats free.
SEI_API_LOOKBACK_DAYS=30
SEI_API_CONCURRENCY=12
SEI_API_TIMEOUT_SECONDS=60

# --- PGP decrypt ---------------------------------------------------------------
# SEI encrypts every drop to the Graphene public key. Base64-encode the armoured
# private key: `base64 -w0 graphene_gpg_privkey.asc`. NEVER commit the decoded key.
#
# REQUIRED, and its absence is the one failure that looks like success: the pull is BYTES
# throughout, so `raw.files` fetches and archives the drop, verifies each trailer and reports
# `synced` — and then every `raw.*` model finds no readable staged CSV. "46 files verified"
# followed by an empty warehouse is what a missing key looks like.
SEI_PGP_PRIVATE_KEY_BASE64=
# Fallback for file-mounted secrets; ignored when the base64 value is set.
SEI_PGP_PRIVATE_KEY_PATH=
SEI_PGP_PASSPHRASE=

# --- Object store (the core bucket) --------------------------------------------
# Encrypted drops land in sei/sftp/, decrypted CSVs in sei/staged/ (docs/storage.md §9).

# --- Warehouse (DuckLake: catalogue in the datalakes Postgres DB, parquet in the
# core bucket's datalake zone — docs/datalake.md). Local stack values shown.

# ── Shared object store + warehouse: set these ONCE in the ROOT `.env`, not here ───────────────
# Every provider service writes parquet into the same core bucket and catalogues it in the same
# `datalakes` Postgres, so these are canonical names the API and the compose stack already use:
#
#   DATALAKE_WRITER_DSN   libpq DSN for lake_writer, e.g.
#                         "dbname=datalakes host=localhost port=5432 user=lake_writer password=lake_writer"
#   S3_CORE_BUCKET        platforms
#   S3_ENDPOINT_HOST      localhost:9000   (host[:port], no scheme — the DuckDB secret's form)
#   S3_ACCESS_KEY_ID      rustfsadmin
#   S3_SECRET_ACCESS_KEY  rustfsadmin
#
# The moon tasks read `/.env` then this file, so a value here still overrides the shared one when a
# provider genuinely needs its own store. It previously had to: each service asked for its own
# `SEI_WAREHOUSE_DSN` / `SEI_S3_*`, so one value lived in three files and a port change meant
# three edits. Worth removing because of how the mistake fails, not because it is untidy: a wrong
# endpoint does not raise — the parquet lands where the reader never looks, and it presents as
# "the catalogue is empty".

# --- What the API adds that the SFTP drop cannot (docs/api-integrations.md §5) ---------------
# The drop is the source for the book and for reference data — 47 reports plus a Reference
# dimension with 183 code sets, which between them answer almost every id an enrolment needs
# (see the table in `models/api_templates.py`). Three things it cannot answer, and they are the
# only reasons this service calls the API at all:
#
#   1. ENROLMENT TEMPLATES. `clientTemplateId`/`accountTemplateId` are REQUIRED to open an
#      account, appear under no Reference TYPE and in no report. `ref.enrollment_templates`
#      reads them (two requests per firm per day).
#   2. EMPLOYEE EMAILS. `UserDetail` has twelve columns and no address. `ref.employee_users`
#      reads `firmemployeeusers` — processingOrgId from firm defaults (not the firm id) plus
#      serviceId (default 1). An unscoped GET 400s; sending the firm id as the org is 200 empty.
#   3. TRANSACTION HISTORY behind a missed drop. The drop is a daily delta and SEI keeps ~5
#      days, so a gap is permanent; `raw.api_transactions` refills it — and returns a DISJOINT
#      population (the cash side only), so it is not a substitute. See that model's header.
#   4. THE ACTIVITY STATE VOCABULARY. The drop carries `ACTIVITY_STATUS` (15 codes) and not the
#      ~430-member state set, so a lodged receipt's `activityState` is an integer with no
#      meaning. `pkgs/sei`'s `ReferenceApi.system_codes` is the lookup; nothing reads it yet.
#
# Everything else that looks like it needs an API call almost certainly does not — check the
# Reference report first.
