# The API (FastAPI). Read by pydantic-settings from `.env` then `.env.local`.
#
# Copy to `.env.local` (gitignored) for local development. This app reads its OWN dotenv files —
# it does NOT read the workspace-root `.env`, which carries the local compose ports and the shared
# warehouse/object-store settings the provider SYNC services need (`.env.example` at the root).
#
# So anything appearing in both places has to be kept in step by hand: nothing derives one from the
# other. In practice that is the object store — if you change `RUSTFS_PORT` in the root `.env`,
# change the S3 URLs here to match.
# ──────────────────────────────────────────────────────────────────────────────────────────────
# App DB role: DML only, subject to RLS
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/portals
# Elevated role used only by Alembic migrations
MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:migrator@localhost:5432/portals

# Which stage this deployment is: dev | staging | production. One stage per instance
# (dev/staging/prod are separate deployments); tenant WorkOS configs are stamped with it.
# Deliberately `production` here, matching config.py's default: this file gets copied onto
# servers, and `dev` is what lets DEMO_AUTH_BYPASS accept an unverified `dev:<b64>` bearer
# token. Set APP_STAGE=dev in your LOCAL .env.local only.
APP_STAGE=production

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
# WorkOS invitation lifetime (1–30 days). Password-reset links remain provider-controlled.
INVITATION_EXPIRES_DAYS=7
# Background reconcile: how often (seconds) to poll WorkOS and re-sync members into the mirror.
# Defaults to 60 — it used to be 0, which meant the mirror drifted silently (onboarded users
# rendered as "Suspended" for ever) with no webhook consumer to cover it. The worker owns the loop;
# a per-environment advisory lock safely coordinates overlapping worker generations or replicas.
# WORKOS_SYNC_POLL_SECONDS=60
API_URL=http://127.0.0.1:8000

# Firm API (`python -m external`), beside the portal API. Local default is the in-memory stub.
# Deployed compose sets EXTERNAL_STUB=false unless this variable is already set.
# EXTERNAL_HOST=127.0.0.1
# EXTERNAL_PORT=8010
# EXTERNAL_STUB=true
# ComplyCube (app/complycube). The API, the worker and the firm API all read these.
# COMPLYCUBE_API_KEY and COMPLYCUBE_WEBHOOK_SECRET are the same settings under their new names.
# HMAC secret for the inbound screening webhook. Blank refuses every delivery.
SCREENING_WEBHOOK_SECRET=
# Screening provider key. Blank fails a live check closed and turns the worker's event loop off.
SCREENING_API_KEY=
# COMPLYCUBE_BASE_URL=https://api.complycube.com/v1
# Outside production a live_ key is ignored unless this is true (live checks are billed).
# COMPLYCUBE_ALLOW_LIVE_KEY=false
# The external process encrypts webhook signing secrets with SECRETS_MASTER_KEY, the same
# key as the API and the worker. Blank fails PUT /webhook closed.

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]
# Also allow every tenant portal host by regex (host-keyed white-label portals). Anchored and
# canary-checked at startup: paired with credentialed CORS, a pattern that matches an origin we
# don't own is a session-theft primitive, so a too-broad one FAILS the boot on purpose.
#   ALLOWED_ORIGIN_REGEX=^https://(client|platform|admin)\.[a-z0-9-]+\.example\.com$
ALLOWED_ORIGIN_REGEX=

# Transactional email (Resend). BLANK DISABLES EVERY SEND: invites, password-reset links and
# task notification emails all become no-ops (the render worker skips its notifier scan and
# /health/ready reports `email: disabled`). Provisioning still works — the set-password link is
# returned in the API response for an operator to copy.
# With a key set, only APP_STAGE=dev and APP_STAGE=staging consult the guard below: only
# EMAIL_ALLOWLIST is mailed, which defaults to @grapheneplatforms.com. Every other stage mails
# anyone.
RESEND_API_KEY=
# Default From for transactional email. Format: "Name <addr@domain>". The domain must be
# DNS-verified in Resend or every send fails.
EMAIL_FROM=Graphene <no-reply@grapheneplatforms.com>
# Resend's webhook signing secret (Svix), from the endpoint's page in the Resend dashboard. It
# carries a `whsec_` prefix; paste it whole, prefix included. BLANK DISABLES THE ENDPOINT — it
# answers `not_configured` and no delivery event is ever applied, so a message stays at `sent` for
# ever and the Activity timeline never advances past it. Absence of configuration means "do
# nothing", never "trust everybody": an unsigned callback is refused, not believed.
RESEND_WEBHOOK_SECRET=
# The delivery SAFETY NET, in seconds; 0 disables it, and the default is 20.
# Leave it ON even with the webhook working: the webhook is the half that can stop silently — a
# deleted endpoint, a rotated secret, a deploy that lost the env var — and every one of those
# leaves messages at 'sent' for ever with nothing to say why.
# A pass costs ONE index scan (`messages_pending_idx` is partial on exactly the unresolved set, so
# it does not grow with the table) and, when that scan finds anything, ONE provider request for the
# whole of Resend's most recent page — with a per-id call only for a row too old to be on it. So a
# healthy deployment makes no provider call at all, and a broken-webhook backlog costs about three
# requests a minute rather than one per stuck message per pass.
# With RESEND_WEBHOOK_SECRET set, a message younger than a minute is left to the webhook: it
# carries the provider's real event time where a poll can only record when it learned, and the
# first writer's stamp is the one that sticks. With no secret there is no webhook to wait for and
# the poll speaks immediately.
COMMS_POLL_SECONDS=20
# Postcoder address autocomplete. The portals forward /api/postcoder to GET /ref/postcoder/*;
# blank ⇒ those endpoints answer 503 and the user types the address by hand.
POSTCODER_API_KEY=
# THE NON-PRODUCTION SEND GUARD — ON BY DEFAULT, and only for APP_STAGE=dev and APP_STAGE=staging.
# On those two stages a recipient is mailed ONLY if it matches EMAIL_ALLOWLIST. Set false as a
# break-glass to mail anyone there, gated only by RESEND_API_KEY. Every other stage ignores this.
EMAIL_NONPROD_GUARD=true
# Who may be mailed on dev and staging. A full address (example@grapheneplatforms.com) or a domain
# (@grapheneplatforms.com); comma-separated or a JSON array, case- and whitespace-insensitive, exact
# domain match (a domain entry does NOT admit its subdomains). UNSET MEANS @grapheneplatforms.com.
# An explicit blank suppresses every dev and staging send (the fail-safe direction). A suppressed
# send is not an error — it returns False and logs at WARNING with the recipient's DOMAIN only;
# /health/ready reports `email: disabled` and `graphene_email_suppressed 1` on /metrics when the
# list is blank.
EMAIL_ALLOWLIST=@grapheneplatforms.com
# Base URL of the internal-operations (admin) portal, used to build set-password links for ops
# staff (whose host isn't in auth.tenant_environments). Blank => those invite links can't be built.
OPERATIONS_PORTAL_URL=

# ---- Observability -----------------------------------------------------------------------
# Log shape: json (one object per line, for a log shipper) | text (human console). Blank =>
# text when APP_STAGE=dev, json otherwise.
LOG_FORMAT=
LOG_LEVEL=INFO
# Error tracking. Off unless a DSN is set AND the optional `sentry-sdk` package is installed;
# failures always still reach the structured log at ERROR.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# GET /metrics (Prometheus text: queue depth, oldest-queued age, throttle rejections, error
# counts). The endpoint is UNAUTHENTICATED, so METRICS_TOKEN is REQUIRED unless APP_STAGE=dev:
# without one it answers 404 outside dev (and logs why) rather than being world-readable wherever
# the API is reachable. Scrape it with the `x-metrics-token` header. Generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Never in git.
METRICS_ENABLED=true
METRICS_TOKEN=

# ---- Rate limiting (unauthenticated surfaces) --------------------------------------------
# Defaults are sane; 0 disables an individual limit. RATE_LIMIT_ENABLED=false disables the lot.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_15M=10
# MFA code guesses per pending challenge (a six-digit TOTP against a token that lives for minutes),
# and per originating IP across challenges. The portals key the challenge on a hash of the token.
# RATE_LIMIT_MFA_PER_CHALLENGE=8
# RATE_LIMIT_MFA_IP_PER_15M=40
# RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
# Per-portal-HOST ALARM on forgot-password sends (our Resend/WorkOS spend). This key is shared by
# every user of a portal, and an anonymous caller reaches it just by varying the email field of a
# public form — so it is ADVISORY: exceeding it never refuses a request (that would be a firm-wide
# password-reset outage anyone could trigger), it logs at ERROR, counts into
# graphene_rate_limit_budget_exceeded_total and degrades /health/ready's `abuse` probe. Size it for
# a firm's legitimate peak so the alarm means something. See app/ratelimit.py.
# ALERT ON THIS: graphene_rate_limit_budget_exceeded_total, or event=rate_limit_budget_exceeded.
# RATE_LIMIT_FORGOT_PASSWORD_HOST_PER_HOUR=500
# Email-template test sends (POST /email-templates/{uid}/send-test) — the one AUTHENTICATED capped
# surface, because what is bounded is Resend spend and a held-down button in an editor costs the same
# as an anonymous flood. Per acting author (the caller can only ever mail themselves), plus an
# ADVISORY per-firm budget that alerts and never refuses (refusing would stop a colleague testing
# their own template).
# RATE_LIMIT_EMAIL_TEST_PER_HOUR=20
# RATE_LIMIT_EMAIL_TEST_TENANT_PER_HOUR=200
# Two more authenticated caps, per acting user per minute: address lookups (each one is a
# metered Postcoder call a client's own form can fire on every keystroke) and in-firm search
# (a full-text query per keystroke). Both refuse with a 429 the portal already knows how to show.
# RATE_LIMIT_POSTCODER_PER_MINUTE=60
# RATE_LIMIT_SEARCH_PER_MINUTE=120

# Public base URL of the client portal, for building shareable document links that open the
# client-portal landing page (e.g. https://portal.example or http://localhost:5173 in dev).
# Blank falls back to the request host.
# CLIENT_PORTAL_BASE_URL=http://localhost:5173
# Dev only: where the identity-photo link opens when it is not the portal above, e.g. the https
# proxy in front of the dev portal (scripts/phone-https-proxy.mjs), so a phone can use the live
# camera.
# IDENTITY_PHONE_BASE_URL=https://localhost:5443

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]


# Envelope-encryption master key for per-tenant WorkOS environment secrets stored in
# auth.environment_secrets (project-per-tenant). The API is the sole holder. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEY=

# Shared secret guarding the internal service-to-service endpoints (the portal fetching
# per-host WorkOS config). Empty disables them (404). Use a long random value.
INTERNAL_API_TOKEN=

# Object storage (S3-compatible) — see docs/storage.md. The S3_* credential is the PLATFORM
# ROOT credential: it provisions per-tenant buckets (t-{uid}, minted at tenant creation)
# and performs the API's own writes. Blank S3_ENDPOINT_URL + creds => storage disabled
# (branding falls back to data: URIs; no buckets are minted). S3_ENDPOINT_URL empty => AWS S3;
# set it for Cloudflare R2 / RustFS / MinIO / Backblaze. Local dev runs a RustFS via
# docker-compose.local.yaml (`pnpm db:up` creates `branding` + `platforms`); point a
# locally-run API at it with: S3_ENDPOINT_URL=http://localhost:9000, S3_BUCKET=branding,
# keys=rustfsadmin, S3_PUBLIC_BASE_URL=http://localhost:9000/branding,
# S3_CORE_BUCKET=platforms.
S3_ENDPOINT_URL=
S3_REGION=auto
# Legacy shared PUBLIC branding bucket (fallback while a tenant's own bucket has no public
# prefix). Blank S3_BUCKET => no shared-bucket fallback. S3_PUBLIC_BASE_URL = its public/CDN
# base (path style, INCLUDING the bucket).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Core bucket (raw/staged provider data — Graphene-internal, never tenant-reachable).
S3_CORE_BUCKET=
# Per-tenant bucket name prefix. AWS bucket names are GLOBAL — hosted deployments should
# namespace it (e.g. graphene-prod-t-). Local default: t-.
S3_TENANT_BUCKET_PREFIX=t-
# Store kind for the tenant-storage registry: rustfs | s3 | minio. Blank = infer (custom
# endpoint => rustfs, none => AWS S3). Set explicitly when deploying against MinIO.
S3_KIND=
# Private documents bucket (uploaded + generated docs) — SEPARATE from the public S3_BUCKET,
# same endpoint/keys. Blank => document storage disabled. Local dev with RustFS (pnpm db:up):
# S3_DOCUMENTS_BUCKET=portals-documents.
S3_DOCUMENTS_BUCKET=

# DuckLake catalogue DB (docs/datalake.md). DATALAKE_DATABASE_URL: as lake_writer, used only
# to ensure a tenant's catalogue schema at provisioning (blank => step skipped). Local:
#   postgresql+psycopg://lake_writer:lake_writer@localhost:5432/datalakes
# DATALAKE_CATALOG_DSN: the same DB as the read-only lake_reader role, libpq DSN fragment for
# DuckDB attaches in app/lake (blank => lake queries unavailable). Local:
#   dbname=datalakes host=localhost port=5432 user=lake_reader password=lake_reader
# DATALAKE_OLTP_DSN: the portals DB as the `app` login — pre-attached read-only as `oltp` on
# lake connections for lake<->OLTP joins with RLS (blank => no OLTP attach). Local:
#   dbname=portals host=localhost port=5432 user=app password=app
DATALAKE_DATABASE_URL=
DATALAKE_CATALOG_DSN=
DATALAKE_OLTP_DSN=
# The provider pipeline daemons (`interlace serve`) — the admin Platforms pages read
# models/plan/runs/events/streams from them and trigger syncs through them. ALL THREE, because a
# blank one is invisible in the worst way: the provider reports `service: unconfigured`, its pages
# still render, and every sync / refresh / rebuild for it answers 503.
# Local: Seccl :8100, Morgan Lloyd :8102, SEI :8103 (`moon run <service>:dev`).
INTERLACE_SECCL_URL=
INTERLACE_MORGAN_LLOYD_URL=
INTERLACE_SEI_URL=
# Public access: set S3_ACL=public-read on providers that use object ACLs (AWS S3, MinIO); leave
# blank on Cloudflare R2 / Backblaze B2 and make the bucket public via a bucket policy instead.
S3_ACL=
# Addressing: blank => path-style when S3_ENDPOINT_URL is set, virtual-hosted for AWS. Set
# S3_FORCE_PATH_STYLE=true/false only if your provider or custom domain needs the other one.
S3_FORCE_PATH_STYLE=

# Outbound webhooks an automation may call (`webhook_out`). A flow author names an endpoint KEY,
# never a URL — a rule that could POST client data to any address its author typed would be a
# standing exfiltration channel — so the key => URL mapping is an operator's decision, made here.
# JSON object or key=url pairs; https only (validated at startup). Blank => no webhook endpoints,
# and any flow naming one is refused at publish.
#   AUTOMATION_WEBHOOK_ENDPOINTS={"crm_sync": "https://example.com/hooks/graphene"}
AUTOMATION_WEBHOOK_ENDPOINTS=

# Endpoints an automation may READ from (`lookup`): the engine POSTs a small mapped body and maps
# fields of the JSON answer into the journey's memory, where a later branch decides on them. Same
# shape and the same https-only rule as the webhook list, and deliberately a SEPARATE list: an
# endpoint we are content to notify is not automatically one we trust to supply the data a client's
# journey then branches on. Blank => no lookup endpoints, and any flow naming one is refused at
# publish. Answers are read under a size cap, must be JSON, and redirects are not followed.
#   AUTOMATION_LOOKUP_ENDPOINTS={"risk_engine": "https://example.com/api/risk-band"}
AUTOMATION_LOOKUP_ENDPOINTS=

# --- The flow engine's AI gates (classify / draft_message; app/flows/ai.py) --------------------
# BLANK MEANS THE FEATURE DOES NOT EXIST: publish refuses a flow naming either action, nothing
# calls out, and no client is constructed. This is the FIRST of two switches — the second is per
# firm (flows.ai_tenants, set at Admin -> the firm -> AI), because a configured deployment must not
# mean an enabled firm. Neither action can decide or send: `classify` writes one label from the
# author's closed set into case memory for a BRANCH to route on, and `draft_message` raises the
# draft as a task for a person to review and send.
ANTHROPIC_API_KEY=
# The model, in configuration rather than in code so it can move without a deploy of code.
AI_MODEL=claude-opus-5
# The per-firm, per-calendar-month token ceiling stamped on a NEW flows.ai_tenants row. A default,
# not the bound — the bound is the row's own column, per firm. Reaching it refuses the action with
# a reason on the step (visible, retryable), never a silent stop.
AI_DEFAULT_MONTHLY_TOKEN_CAP=1000000

# ── Provider credentials the API itself calls out with ────────────────────────────────────────
# These are NOT sync-service-only. Each is on a request path a user can trigger from a portal, so
# the API container needs them and `docker-compose.yaml` passes them to the `api` service.

# CTC — the Morgan Lloyd SIPP illustration engine. No credentials: it identifies the caller by
# `<agent_name>`. CTC_ENABLED off (or a blank agent name) => a MARKED PLACEHOLDER PDF is filed
# instead of a quotation, which is deliberate — an illustration that reads as a quotation and
# isn't is the one thing that feature must never produce quietly.
CTC_ENABLED=false
CTC_AGENT_NAME=

# Morgan Lloyd (Dynamics 365) — drawdown sessions, contact/scheme sync, cam_contribution.
# MORGAN_LLOYD_ADVISER_FIRM_ID is a prerequisite for scheme creation, not an option: without it a
# contact is created unattached and every later cam_createscheme 403s.
#
# The last three are FIXED REFERENCE VALUES the vendor issues per integrating firm, in
# "Morgan Lloyd API Details- Graphene.docx" — none is discoverable from the API. SCHEME_TYPE and
# SIPP_TYPE are option-set members with no documented labels, validated by the vendor as a PAIR
# ("Invalid Scheme and Sipp Type combination"); INVESTMENT_PROVIDER_ID is the `provider` GUID that
# cam_createwrapper and cam_createpolicyvaluation both take. Blank means the operation that needs
# one refuses naming it, rather than sending a plausible-looking wrong value into a live
# back-office system. For the Clifton dev org they are 16 / 809130016 /
# 6ac39921-d8b7-f011-bbd3-7ced8d6b85ff.
#
# ADVISER_FIRM_ID AND INVESTMENT_PROVIDER_ID ARE THE SAME GUID. The vendor asks for it as
# `cam_financialadviser_Account`, as `accountId` and as `provider`, calling all three "the
# Firm ID we provided you" -- confirmed live, every synced contact carries it as
# `_cam_financialadviser_value`. Setting ADVISER_FIRM_ID alone is enough; the other falls
# back to it and exists only for a firm the vendor issues two.
# It is NOT MORGAN_LLOYD_TENANT_ID: that is the Azure DIRECTORY, this is a Dynamics
# `accounts` row inside it.
#
# ADVISER_CONTACT_ID is a FOURTH identifier and required TOGETHER with the firm: a
# contact attached to a firm with no adviser contact is refused outright ('Financial
# Adviser contact must be populated for the adviser firm'). It is a person, not an
# account, and both are sent as entity references (`/contacts(...)`, `/accounts(...)`) —
# a bare GUID is 'Invalid Format'. Discoverable from the firm via
# cam_getadvisercontacts, so blank is fine when the firm has exactly one adviser.
MORGAN_LLOYD_RESOURCE_URL=
MORGAN_LLOYD_TENANT_ID=
MORGAN_LLOYD_CLIENT_ID=
MORGAN_LLOYD_CLIENT_SECRET=
MORGAN_LLOYD_ADVISER_FIRM_ID=
MORGAN_LLOYD_ADVISER_CONTACT_ID=
MORGAN_LLOYD_SCHEME_TYPE=
MORGAN_LLOYD_SIPP_TYPE=
MORGAN_LLOYD_INVESTMENT_PROVIDER_ID=

# Intelliflo Office — the platform portal's "Link to IO" cards and the admin Clients and Accounts
# tab's client/plan search and link write-back. OAuth2 client-credentials grant
# (CLIENT_ID/_SECRET/GRANT_TYPE/SCOPE/TENANT_ID) plus a separate x-api-key on the client/plan calls
# (API_KEY). BASE_URL is the Intelliflo Office API host for the integrating firm's environment.
INTELLIFLO_CLIENT_ID=
INTELLIFLO_CLIENT_SECRET=
INTELLIFLO_GRANT_TYPE=client_credentials
INTELLIFLO_SCOPE=
INTELLIFLO_TENANT_ID=
INTELLIFLO_BASE_URL=
INTELLIFLO_API_KEY=

# iDenfy — digital identity verification for the `verify_identity` flow step (app/idv).
# BLANK KEY OR SECRET MEANS THE PROVIDER DOES NOT EXIST HERE: the seeded onboarding keeps
# `provider: manual` with the step assigned to STAFF, and publishing a flow that names `idenfy` is
# refused at preflight rather than failing mid-journey on a real client. With both set, the seed
# assigns the step to the CLIENT and the portal shows iDenfy's capture flow in an iframe.
#
# IDENFY_CALLBACK_URL is not optional in practice: it is stamped on every token, and without it
# iDenfy sends no verdict, so a client finishes the capture and the journey waits for ever. It must
# be this API's own publicly-reachable /webhooks/idenfy.
#
# IDENFY_WEBHOOK_SECRET is optional (the legacy platform verified nothing). Set it where iDenfy's
# dashboard has a signing key: the callback is then rejected unless it carries a matching
# HMAC-SHA256 of the raw body.
IDENFY_BASE_URL=https://ivs.idenfy.com
IDENFY_API_KEY=
IDENFY_API_SECRET=
IDENFY_CALLBACK_URL=
IDENFY_WEBHOOK_SECRET=

# SEI SWP — lodges an Anticipated Cash Receipt when a contribution is booked. Three credentials
# stack: the mTLS client certificate (the machine identity SEI's allowlist keys on), an OAuth
# password grant, and a separate app-gateway AppKey sent on every call.
#
# Supply the PKCS#12 bundle as BASE64, not a path: a path needs a file in the container, and a
# container deployment configured from one env list has nowhere to put one. `base64 -w0 x.pfx`.
#
# SEI also restricts by SOURCE IP, so correct credentials are necessary but not sufficient — the
# call must leave an allowlisted host. That surfaces as SeiAuthError, not an outage.
SEI_ENVIRONMENT=i31
SEI_OAUTH_USERNAME=
SEI_OAUTH_PASSWORD=
SEI_APPKEY=
SEI_APPSECRET=
SEI_PFX_BASE64=
SEI_PFX_PASSWORD=

# SEI's own withdrawal rail fee — the same for every firm, so it is a deployment setting rather
# than something a firm configures. BACS carries none, which is why there is no BACS key here.
# Defaults are today's published rates; change these if SEI's pricing changes, no deploy needed.
SEI_FASTER_PAYMENT_FEE=0.50
SEI_SWIFT_FEE=15.00

# NOTE: there is nothing here for the provider pipeline itself. The projection and the merge run
# INSIDE each provider's own interlace DAG now (`pkgs/book-sink`, docs/provider-pipeline.md), as
# `book_writer` — so they are configured on the DAEMONS, not on the API, and the one value they
# need (`BOOK_WRITER_DSN`) lives in the ROOT `.env` because all three services read it.
#
# `FANOUT_POLL_SECONDS` and `MATERIALISE_AFTER_FANOUT` used to sit here. Both are gone with
# `app/fanout_listener.py` and `app/materialise.py`; neither key exists on `Settings`, and
# `model_config`'s `extra="ignore"` swallowed them silently — so copying this file gave you two
# dead knobs that read as live controls.

# ── Local login bootstrap (`pnpm db:bootstrap` / `moon run api:bootstrap-dev`) ─────────────────
# Not Settings fields — `scripts/bootstrap_dev_environment.py` reads them from this file.
# Each portal is its OWN WorkOS application; without the id+secret pair, that host's sign-in
# reads as 503 misconfigured. Cookie password lives with WORKOS_* above and must match the
# portals' `WORKOS_COOKIE_PASSWORD` (iron-session's floor is 32 characters).
# DEV_CLIENT_PORTAL_APP_ID=
# DEV_CLIENT_PORTAL_APP_SECRET=
# DEV_PLATFORM_APP_ID=
# DEV_PLATFORM_APP_SECRET=
# DEV_OPERATIONS_APP_ID=
# DEV_OPERATIONS_APP_SECRET=
