# The Graphene internal admin portal (SvelteKit — ops/RMs).
#
# Copy to `.env.local` (gitignored) for local development. This app reads its OWN dotenv files —
# it does NOT read the workspace-root `.env`, which carries the local compose ports and the shared
# warehouse/object-store settings the provider SYNC services need (`.env.example` at the root).
# ──────────────────────────────────────────────────────────────────────────────────────────────
# WorkOS (identity). Same app credentials as the API.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ char secret used to encrypt the session cookie. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Base URL of the FastAPI backend (server-side calls only).
API_URL=http://127.0.0.1:8000

# Which deployment this portal is: dev | staging | production. The same value as the API's
# APP_STAGE. The tenant page shows the outbound-email restriction only when this is dev or staging.
# A blank value is treated as production, so the notice stays hidden.
APP_STAGE=dev

# Shared secret for the API's internal service-to-service endpoints. MUST match the API's
# INTERNAL_API_TOKEN: it is how this portal fetches its per-host WorkOS config, sends
# forgot-password links and consults the login rate limiter. Blank => those endpoints 404 and
# the forgot-password form is a silent no-op.
INTERNAL_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────────────────────
# Content-Security-Policy (optional). Baseline security headers are always set in hooks.server.ts
# (X-Frame-Options: SAMEORIGIN, nosniff, Referrer-Policy, Permissions-Policy) and cannot be disabled.
# Only the CSP is tunable per environment, so a fuller policy can be trialled without a code deploy
# (these are read at runtime via $env/dynamic/private — a Coolify env change + restart applies them).
# Blank CSP_POLICY => the default "frame-ancestors 'self'" (same-origin framing only).
# CSP_REPORT_ONLY=true sends the policy as Content-Security-Policy-Report-Only (observe, do not
# enforce) for tuning; X-Frame-Options still blocks other-origin framing regardless.
CSP_POLICY=
CSP_REPORT_ONLY=
